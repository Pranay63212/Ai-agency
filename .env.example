# Copy this file to .env and fill in your values. .env is git-ignored: never share it.

# AI that writes messages and reads replies (free key at build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here

# Email sending + reply checking. Gmail: turn on 2-Step Verification, then create an
# App Password (Google Account > Security > App passwords) and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-letter-app-password
# Optional. If left out, each client's emails show as "<Sender> at <Business>".
# SMTP_FROM=Mike at Comfort Pro HVAC <you@gmail.com>

# Clients who gave you their own mailbox (created with --email-user): one line each
# EMAIL_PASSWORD_COOL_AIR_HVAC=their-16-letter-app-password

# Texting (optional, paid): only after A2P 10DLC registration
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+12145550100
